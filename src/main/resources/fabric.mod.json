	"name": "AFK Totem Logout",
	"description": "Verlaesst Server/Welt automatisch, wenn dein Totem poppt waehrend du mindestens 10 Sekunden AFK bist.",
	"authors": ["Du"],
	"license": "MIT",
	"environment": "client",
